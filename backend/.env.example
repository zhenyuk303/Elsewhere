# MySQL Server installation (default port)
DB_URL=jdbc:mysql://127.0.0.1:3306/elsewhere?characterEncoding=UTF-8&connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true
DB_USERNAME=elsewhere
DB_PASSWORD=replace-with-your-local-password
# Docker Compose users set DB_URL port to 13306 and set this password.
MYSQL_ROOT_PASSWORD=replace-with-your-local-root-password
# Configure your own OAuth credentials locally if needed.
CLIENT_ID_GOOGLE=
CLIENT_SECRET_GOOGLE=
CLIENT_ID_GITHUB=
CLIENT_SECRET_GITHUB=
